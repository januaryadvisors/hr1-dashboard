{
  "name": "hr1-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Texas SNAP & H.R. 1 \u2014 D1 county vulnerability dashboard for Feeding Texas.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:geometry": "node scripts/build-geometry.mjs",
    "build:fixtures": "node scripts/build-fixtures.mjs",
    "build:data": "npm run build:geometry && npm run build:fixtures",
    "fetch:bulletins": "node scripts/fetch-texas-works.mjs",
    "serve:pages": "node scripts/serve-as-pages.mjs",
    "fetch:snap": "node scripts/fetch-snap-stats.mjs",
    "fetch:data": "npm run fetch:bulletins && npm run fetch:snap"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "mapshaper": "^0.6.102",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "xlsx": "^0.18.5"
  }
}
